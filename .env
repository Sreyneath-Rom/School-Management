NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/high_school_db?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
POSTGRES_DB=high_school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
