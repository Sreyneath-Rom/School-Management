# ==========================================================
# High School Management API — Environment Variables
# ==========================================================
# Local development config. Do NOT commit this file.
# ==========================================================

# ---------------------------
# Application
# ---------------------------
NODE_ENV=development
PORT=5000

# ---------------------------
# Database (Prisma 7 / PostgreSQL)
# ---------------------------
DATABASE_URL=postgresql://postgres:replace-with-your-postgres-password@localhost:5432/high_school_db

# ---------------------------
# JWT Authentication
# ---------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------
# CORS
# ---------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------
# File Uploads
# ---------------------------
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10

# ---------------------------
# Rate Limiting
# ---------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------
# Email (used for password reset once implemented)
# ---------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace-with-your-gmail-address
EMAIL_PASSWORD=replace-with-your-gmail-app-password