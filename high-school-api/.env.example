# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Uncomment to override the default log level. Default is 'debug' in
# development, 'info' in production.
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
#
# Local development: point at a running Postgres.
# In Docker Compose, this value is overridden by docker-compose.yml to use
# the service name "postgres" instead of "localhost".
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/high_school_db?schema=public

# Compose-specific: used by the postgres service and by the healthcheck.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-in-production
POSTGRES_DB=high_school_db

# -----------------------------------------------------------------------------
# JWT
#
# Both secrets must be at least 32 characters in production. The env schema
# rejects shorter values, placeholder strings ("change-me", "secret"), and
# equal values for both fields.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=high-school-api
JWT_AUDIENCE=high-school-clients

# -----------------------------------------------------------------------------
# HTTP
#
# CORS_ORIGIN is a comma-separated list. The frontend's dev server is
# typically http://localhost:5173 (Vite) or http://localhost:3000 (CRA).
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Swagger
#
# Off by default in production. Turn on only if you have an external gate
# (VPN, IP allowlist, basic auth) in front of /api-docs.
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=false
# Optional. Defaults to http://localhost:{PORT}/api/v1. Set this in
# production so "Try it out" hits the right host.
# SWAGGER_SERVER_URL=https://api.school.example/api/v1

# -----------------------------------------------------------------------------
# Uploads
#
# UPLOAD_PATH is relative to the working directory. In the Docker image,
# this resolves to /app/uploads, which is mounted as a named volume.
# MAX_UPLOAD_MB must be less than or equal to nginx's client_max_body_size
# for the corresponding location (currently 12m for /api/v1/school/logo).
# -----------------------------------------------------------------------------
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# pgAdmin (Compose)
#
# Change these before running `docker compose up`. The Compose file
# requires them — it won't start pgAdmin without them.
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@school.local
PGADMIN_PASSWORD=change-this-in-production

# -----------------------------------------------------------------------------
# Email (optional — required for password reset)
#
# Leave blank until you're ready to enable password reset. The auth module's
# forgotPassword endpoint logs the reset token instead of sending it when
# these are unset.
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (optional — for future permission caching)
# -----------------------------------------------------------------------------
REDIS_URL=