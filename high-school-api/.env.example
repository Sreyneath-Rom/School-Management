# =============================================================================
# High School Management System — API
# Local development environment file
#
# Copy to `.env` and adjust values. Never commit the real `.env` to version
# control — `.gitignore` should list it (verify with `git check-ignore .env`).
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Log level override. Default is 'debug' in development, 'info' in production.
# Uncomment to force a specific level:
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
#
# Local development: point at a Postgres you run on the host.
# Inside Docker Compose, docker-compose.yml OVERRIDES this to use the
# service name "postgres" instead of "localhost" — the value here is only
# used when you run `npm run dev` on the host directly.
#
# If you're using the Compose stack only, this value is unused by the API
# container but still read by the Prisma CLI when you run migrations or
# generate from the host.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/high_school_db?schema=public

# Compose-specific — read by the postgres service and by the API's
# DATABASE_URL override. Keep these in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=high_school_db

# -----------------------------------------------------------------------------
# JWT
#
# Both secrets must be at least 32 characters in production. The env schema
# rejects shorter values, known placeholder strings ("change-me", "secret",
# "password"), and equal values for both fields.
#
# Generate fresh ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The values below are DEV-ONLY. Anyone with read access to this repo can
# forge tokens signed with them.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-please-replace-in-production-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-please-replace-in-production-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=high-school-api
JWT_AUDIENCE=high-school-clients

# -----------------------------------------------------------------------------
# HTTP
#
# CORS_ORIGIN is a comma-separated list. Include every origin the frontend
# may be served from. In development, the Vite dev server is at :5173 and
# CRA is at :3000 — both are listed so you can switch without editing this.
#
# In production, this must be the real frontend origin, NOT a wildcard.
# The env schema rejects "*" when NODE_ENV=production.
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Global rate limit. Applies to every route except /health and the
# auth-specific limiter (which has its own tighter limits).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Swagger
#
# In development, the docs are always available at /api-docs regardless of
# this flag. In production, they're gated behind it. Turn on only if you
# have an external gate (VPN, IP allowlist, basic auth) in front.
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
# Optional override for the "Try it out" server URL. Defaults to
# http://localhost:{PORT}/api/v1 in development.
# SWAGGER_SERVER_URL=https://api.school.example/api/v1

# -----------------------------------------------------------------------------
# Uploads
#
# UPLOAD_PATH is relative to the working directory.
#   - Host dev (`npm run dev`): creates ./uploads next to package.json
#   - Docker: resolves to /app/uploads, mounted as a named volume
#
# MAX_UPLOAD_MB must be <= nginx's client_max_body_size for the corresponding
# location. nginx.conf currently allows 12m for /api/v1/school/logo; if you
# raise this above 12, raise nginx too — otherwise nginx returns 413 before
# the app has a chance to enforce its own limit.
# -----------------------------------------------------------------------------
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# pgAdmin (Docker Compose only)
#
# Required by docker-compose.yml — the pgAdmin service won't start without
# them. Change these before running `docker compose up` on any host that
# isn't your laptop, since pgAdmin binds to port 5050.
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@school.local
PGADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Email (optional — required for password reset)
#
# Leave blank in development. The auth module's forgotPassword endpoint
# logs the reset token to the console instead of sending an email when
# these are unset — copy the token from the log to test the reset flow.
#
# For SMTP testing, Mailtrap or MailHog both work:
#   EMAIL_HOST=smtp.mailtrap.io
#   EMAIL_PORT=2525
#   EMAIL_USER=<mailtrap-user>
#   EMAIL_PASSWORD=<mailtrap-password>
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Redis (optional — reserved for future permission caching)
#
# Currently unused. Set when you add Redis-backed caching for permission
# lookups; the env schema validates the URL format when present.
# -----------------------------------------------------------------------------
REDIS_URL=