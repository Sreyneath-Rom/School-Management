# Copy this file to .env for API-local development.
# The API also reads ../.env when started from this directory.

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/high_school_db?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-development-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-development-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
