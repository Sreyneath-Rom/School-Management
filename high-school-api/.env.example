# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000
APP_NAME=High School Management

# ==========================================
# Database (PostgreSQL + Prisma)
# ==========================================
# These three are read by docker-compose.yml to provision the Postgres
# container AND by DATABASE_URL below — change them here only, in one place.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=high_school_db

# Host is "localhost" when running the API directly on your machine.
# When running via `docker compose up`, this value is OVERRIDDEN inside
# docker-compose.yml to use the "postgres" service name instead — see the
# `environment:` block on the `api` service. You don't need to edit this
# line for Docker; it's only used for local (non-Docker) `npm run dev`.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# ==========================================
# JWT Authentication
# ==========================================
JWT_ACCESS_SECRET=your-super-secret-access-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:5173

# ==========================================
# File Upload
# ==========================================
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=10

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ==========================================
# Password Hashing
# ==========================================
BCRYPT_ROUNDS=12

# ==========================================
# Email (optional)
# ==========================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ==========================================
# Redis (optional)
# ==========================================
REDIS_URL=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info