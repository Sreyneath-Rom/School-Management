{
  "name": "school-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "high-school-admin-UI",
    "high-school-student-UI",
    "high-school-teacher-UI",
    "high-school-api"
  ],
  "scripts": {
    "dev": "npm run dev:admin",
    "dev:admin": "npm run dev --workspace=high-school-admin",
    "dev:student": "npm run dev --workspace=high-school-student",
    "dev:teacher": "npm run dev --workspace=high-school-teacher",
    "dev:api": "npm run dev --workspace=high-school-api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace=high-school-api"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3"
  }
}
